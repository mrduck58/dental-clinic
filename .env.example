# ─────────────────────────────────────────────────────────────────
# Sao chép file này thành .env rồi điền giá trị thật:
#   cp .env.example .env
# File .env đã được gitignore — KHÔNG commit file .env thật.
# ─────────────────────────────────────────────────────────────────


# ── Supabase ──────────────────────────────────────────────────────
# Lấy tại: https://supabase.com/dashboard → Project Settings → API

SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ── Database (dùng cho API .NET — format Npgsql) ──────────────────
# Lấy tại: Supabase → Project Settings → Database → Connection string → chọn tab ".NET"
# Lưu ý: dùng port 6543 (Transaction pooler), KHÔNG dùng port 5432 trực tiếp

SUPABASE_DB_URL=Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.xxxxxxxxxxxxxxxxxxxx;Password=your-db-password;SslMode=Require;TrustServerCertificate=true;


# ── API (.NET 9) ──────────────────────────────────────────────────
# JWT_SECRET: chuỗi ngẫu nhiên dài ≥ 32 ký tự
#   Tạo nhanh: openssl rand -base64 48

JWT_SECRET=your-jwt-secret-at-least-32-chars-long
ASPNETCORE_ENVIRONMENT=Production


# ── Frontend (Next.js) ────────────────────────────────────────────
# Khi chạy Docker: giữ nguyên http://localhost/api (nginx proxy)
# Khi deploy lên server: đổi thành domain thật, ví dụ https://api.example.com

NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
